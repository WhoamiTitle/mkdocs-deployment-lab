# Public configuration. Copy values into GitHub repository variables.
HELIOS_HOST=helios.example.edu
HELIOS_USER=student
HELIOS_PORT=22
HELIOS_DEPLOYMENT_ROOT=public_html/.research-site-deploy
HELIOS_PUBLIC_PATH=public_html/research-site
HELIOS_BASE_URL=https://helios.example.edu/~student/research-site/

# Local paths used by the CLI. In GitHub Actions their contents are created
# from HELIOS_SSH_KEY and HELIOS_KNOWN_HOSTS secrets.
HELIOS_SSH_KEY_PATH=.secrets/helios_key
HELIOS_KNOWN_HOSTS_PATH=.secrets/known_hosts
